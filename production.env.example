# ════════════════════════════════════════════════════════════════════
# XAUUSD Autonomous Trading System — Production Environment Template
# ════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Trading Mode ────────────────────────────────────────────────
# paper  = no real trades, simulated balance
# demo   = MT5 demo account (real orders, no real money)
# live   = MT5 live/funded account (REAL MONEY — FTMO challenge)
AUTONOMOUS_MODE=paper

AUTONOMOUS_SYMBOL=XAUUSD
AUTONOMOUS_TIMEFRAME=H1

# ─── MetaTrader 5 ────────────────────────────────────────────────
# Required for demo/live mode
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=ICMarkets-Demo

# Execution settings
AUTO_MAGIC_NUMBER=20260513
AUTO_ORDER_COMMENT=Autonomous XAUUSD
AUTO_MAX_SLIPPAGE_POINTS=30

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
POSTGRES_URL=postgresql://user:password@localhost:5432/xauusd

# OR Supabase
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# SQLite fallback (no configuration needed)
# Leave both empty to use: autonomous_xauusd.db (local SQLite)

# ─── Telegram — @HamzaFTMOBot ────────────────────────────────────
# Enige bot voor notificaties + inline-keyboard control interface.
# Gebruik ALTIJD de @HamzaFTMOBot token.  Geen andere bots.
TELEGRAM_BOT_TOKEN=your-hamzaftmobot-token-from-botfather
TELEGRAM_CHAT_ID=your-personal-chat-id
TELEGRAM_OWNER_USER_ID=your-telegram-user-id

# ─── API Security ────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-minimum-32-chars
API_KEY=your-internal-api-key-for-telegram-backend-calls
TELEGRAM_CONTROL_API_KEY=same-as-api-key
TELEGRAM_BACKEND_BASE_URL=http://127.0.0.1:8000

# ─── FTMO Risk Parameters ────────────────────────────────────────
# Account size
FTMO_START_CAPITAL=160000
FTMO_MAX_DAILY_LOSS=8000
FTMO_MAX_TOTAL_DRAWDOWN=16000
FTMO_MONTHLY_PROFIT_TARGET=16000

# ─── Strategy Parameters ─────────────────────────────────────────
AUTO_EMA_FAST=8
AUTO_EMA_SLOW=21
AUTO_EMA_TREND=50
AUTO_RSI_PERIOD=14
AUTO_ATR_PERIOD=14

# Risk per trade (as fraction of equity)
AUTO_RISK_PER_TRADE=0.005       # 0.5% default
AUTO_RISK_STRONG_REGIME=0.015   # 1.5% in strong trend
AUTO_RISK_WEAK_REGIME=0.008     # 0.8% in weak trend

AUTO_STOP_LOSS_ATR=1.0
AUTO_TAKE_PROFIT_ATR=3.0

# ─── Cycle Settings ──────────────────────────────────────────────
AUTO_POLL_INTERVAL_SECONDS=15
AUTO_HISTORY_BARS=500
AUTO_MAX_OPEN_POSITIONS=1
AUTO_MAX_CONSECUTIVE_ERRORS=5
AUTO_TRAIN_EVERY_DAYS=7
AUTO_DAILY_REPORT_HOUR_UTC=19

# Paper mode starting balance
AUTO_PAPER_START_BALANCE=10000.0

# ─── News & Sentiment ────────────────────────────────────────────
# NewsAPI.org key (optional, but improves news quality)
NEWSAPI_KEY=your_newsapi_key_here

NEWS_CACHE_MINUTES=20
NEWS_MAX_HEADLINES=40
NEWS_LOCK_BEFORE_MIN=30
NEWS_LOCK_AFTER_MIN=20
NEWS_DANGER_THRESHOLD=0.65
SPREAD_LOCK_POINTS=50
ATR_SPIKE_MULTIPLIER=2.5

SENTIMENT_CACHE_MINUTES=30
SENTIMENT_FILTER_THRESHOLD=0.5

# ─── Backend API ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=production

# Admin credentials (for dashboard login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Docker / Production ─────────────────────────────────────────
# Used by docker-compose.yml
POSTGRES_DB=xauusd
POSTGRES_USER=xauusd
POSTGRES_PASSWORD=change-this-db-password
